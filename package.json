{
  "name": "fx-durable",
  "version": "0.3.0",
  "description": "Durable agents on libfx: tool calls with replay policies, documents, subagents, and extensions around libfx's durable sessions.",
  "keywords": [
    "libfx",
    "fx",
    "agents",
    "ai-agents",
    "durable-execution",
    "crash-recovery",
    "sqlite",
    "effect",
    "journal"
  ],
  "homepage": "https://github.com/jagenaujagenau/fx-durable#readme",
  "bugs": {
    "url": "https://github.com/jagenaujagenau/fx-durable/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jagenaujagenau/fx-durable.git"
  },
  "license": "MIT",
  "author": "Diego Peralta <hi@diegoperalta.com>",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./sqlite": {
      "types": "./dist/durable/sqlite/index.d.ts",
      "default": "./dist/durable/sqlite/index.js"
    },
    "./tools": {
      "types": "./dist/tools/index.d.ts",
      "default": "./dist/tools/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./effect": {
      "types": "./dist/effect.d.ts",
      "default": "./dist/effect.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc --noEmit -p . && tsc -p tsconfig.check.json",
    "test": "vitest run",
    "lint": "oxlint",
    "prepublishOnly": "pnpm typecheck && pnpm lint && pnpm build"
  },
  "dependencies": {
    "effect": "4.0.0",
    "libfx": "0.0.13-dev.1432.g1df91f0b4ebf"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.86.0",
    "@types/node": "^26.6.4",
    "oxlint": "1.86.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "zod": "4.6.5"
  }
}
